DISCORD_BOT_TOKEN=PASTE_YOUR_DISCORD_BOT_TOKEN_HERE
ENGLISH_CHANNEL_ID=PASTE_ENGLISH_CHANNEL_ID_HERE
SPANISH_CHANNEL_ID=PASTE_SPANISH_CHANNEL_ID_HERE
PORTUGUESE_CHANNEL_ID=PASTE_PORTUGUESE_CHANNEL_ID_HERE
FRENCH_CHANNEL_ID=PASTE_FRENCH_CHANNEL_ID_HERE
GERMAN_CHANNEL_ID=PASTE_GERMAN_CHANNEL_ID_HERE
TURKISH_CHANNEL_ID=PASTE_TURKISH_CHANNEL_ID_HERE
ARABIC_CHANNEL_ID=PASTE_ARABIC_CHANNEL_ID_HERE
CHINESE_CHANNEL_ID=PASTE_CHINESE_CHANNEL_ID_HERE

# Existing CHiP announcement channel supplied by Nick.
ANNOUNCEMENT_CHANNEL_ID=1529511999891964015

# Azure Translator (use a single-service global Translator F0 resource).
AZURE_TRANSLATOR_KEY=PASTE_AZURE_TRANSLATOR_KEY_HERE
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
# Leave blank for a single-service global resource. Regional/multi-service
# resources require the exact region from Azure's Keys and Endpoint page.
AZURE_TRANSLATOR_REGION=

# OpenAI API billing is separate from ChatGPT. Create a dedicated CHiP project
# key, add $5 prepaid credit, and leave automatic recharge OFF.
OPENAI_API_KEY=PASTE_OPENAI_PROJECT_API_KEY_HERE
OPENAI_MODEL=gpt-5.6-terra
# Member conversations use low-cost Luna with the same key and shared cap.
CHIP_CHAT_MODEL=gpt-5.6-luna
TERRA_BUDGET_USD=4.50

# Optional: set this in Railway, or choose the channel later with
# /chip channel. When blank, members can still use /chip chat or @mention CHiP.
CHIP_CHAT_CHANNEL_ID=
CHIP_CHAT_COOLDOWN_SECONDS=15
CHIP_CHAT_MAX_OUTPUT_TOKENS=500

# Recommended Railway volume mount. This keeps CHiP's usage totals, member chat
# history, contests, and state across deployments. Mount a volume at /data.
CHIP_DATA_DIR=/data

# Optional private alert destination. If blank, CHiP attempts to DM the bot's
# application owner and otherwise records alerts only in Railway logs.
ADMIN_LOG_CHANNEL_ID=
OWNER_USER_ID=

# Files above this size are relayed using their protected Discord CDN URL.
MAX_RELAY_FILE_MB=20

# Maximum image size Nick or MsMax can add to a CHiP contest.
MAX_CONTEST_IMAGE_MB=10
